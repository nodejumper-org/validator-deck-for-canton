{
  "name": "canton-validator-dashboard",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.11" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "start": "npm run start --workspace apps/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -b --pretty packages/canton-client",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate --workspace apps/web",
    "db:studio": "npm run db:studio --workspace apps/web",
    "smoke": "node --env-file=.env ./node_modules/vitest/vitest.mjs run packages/canton-client/src/__tests__/live.test.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "@types/node": "^24.10.1"
  }
}
