# Secret used to encrypt stored OIDC client secrets at rest (AES-256-GCM).
# Generate with: openssl rand -hex 32
APP_SECRET=

# Postgres 18 from docker-compose.yml. `pglite://memory` runs an in-process
# Postgres instead, which is what the test suite uses.
DATABASE_URL=postgres://canton:canton@localhost:5434/canton_dashboard

# Optional: only used by `npm run smoke` to exercise a real node read-only.
SMOKE_LEDGER_API_URL=
SMOKE_VALIDATOR_API_URL=
SMOKE_AUTH_TOKEN_URL=
SMOKE_AUTH_CLIENT_ID=
SMOKE_AUTH_CLIENT_SECRET=
SMOKE_AUTH_AUDIENCE=
SMOKE_AUTH_SCOPE=
