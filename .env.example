# ── Validator Deck for Canton :: environment ─────────────────────────────────
#
# One file, two uses:
#   • locally  — copy to `.env` at the repo root; `npm run dev` reads it
#   • deployed — copy to `~/validator-deck/.env` on the host and fill it in
#
# On a deploy host this is the single source of truth and it persists across
# deploys: the workflow rewrites ONLY the IMAGE_TAG line. Never commit a filled
# copy. dev and prod differ in values, never in which keys are present.

# Image tag the deploy stacks pull (dev, or a vX.Y.Z release tag).
IMAGE_TAG=dev

# ── Secrets ───────────────────────────────────────────────────────────────────
# Encrypts stored OIDC client secrets at rest (AES-256-GCM). Losing it makes
# every registered node's credentials unreadable. Generate: openssl rand -hex 32
APP_SECRET=

# Signs session cookies. Generate separately: openssl rand -hex 32
# Falls back to APP_SECRET if unset, which is fine locally but not in production.
BETTER_AUTH_SECRET=

# ── Public URL ────────────────────────────────────────────────────────────────
# The origin the app is served from. Must match exactly in production, including
# scheme — sign-in fails if it does not.
BETTER_AUTH_URL=http://localhost:3000

# ── Caddy (docker-compose.prod.yml only) ──────────────────────────────────────
# The dev stack has no Caddy: the host's own reverse proxy fronts it.
VALIDATOR_DECK_DOMAIN=deck.example.com
# Contact address Let's Encrypt uses for certificate-expiry notices.
CADDY_ACME_EMAIL=ops@example.com

# ── Database ──────────────────────────────────────────────────────────────────
# Local development against the compose Postgres:
DATABASE_URL=postgres://canton:canton@localhost:5434/canton_dashboard
# Deployed, the service name resolves inside the compose network. env_file does
# NOT interpolate, so write the password out literally in both places:
#   POSTGRES_PASSWORD=CHANGE_ME
#   DATABASE_URL=postgres://canton:CHANGE_ME@db:5432/canton_dashboard
POSTGRES_PASSWORD=canton
# Host port the database is published on. Loopback-only in the deploy stacks.
DB_PORT=5434
# Host port the web container publishes on in the dev stack (prod uses Caddy).
WEB_PORT=3000

# ── Scheduled work ────────────────────────────────────────────────────────────
# How often to look for nodes whose local-party list has gone stale. The sweep
# itself takes about a minute per node, so this only decides how promptly a stale
# list is refreshed. Set to "off" to disable and rely on the Refresh button.
PARTY_SCAN_CRON=*/10 * * * *

# ── Live smoke test (optional, local only) ────────────────────────────────────
# `npm run smoke` runs read-only checks against a real Canton node. Leave empty
# to skip them.
SMOKE_LEDGER_API_URL=
SMOKE_VALIDATOR_API_URL=
SMOKE_AUTH_TOKEN_URL=
SMOKE_AUTH_CLIENT_ID=
SMOKE_AUTH_CLIENT_SECRET=
SMOKE_AUTH_AUDIENCE=
SMOKE_AUTH_SCOPE=
